# --- LOKASYON AYARLARI ---
LATITUDE=41.0067
LONGITUDE=39.7229
SEHIR=Trabzon

# --- TELEGRAM API BİLGİLERİ ---
# BotFather'dan aldığınız token'ı buraya girin
TELEGRAM_TOKEN=buraya_kendi_bot_tokenini_yaz
VARSAYILAN_CHAT_ID=buraya_kendi_chat_id_numarani_yaz

# --- ARDUINO AYARLARI ---
# Windows için genelde COM3 vb. Linux için /dev/ttyACM0 veya /dev/ttyUSB0
ARDUINO_PORT=/dev/ttyACM0

# --- REHBER ---
# Telefon rehberini JSON formatında ekleyin (isimler küçük harf olmalı)
REHBER={"arkadasim": "123456789", "kendim": "987654321"}